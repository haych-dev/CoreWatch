<UserControl x:Class="CoreWatch.Pages.ReliabilityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CoreWatch.Controls">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="1560">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Reliability" Style="{StaticResource T.Page}" />
                    <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" Margin="0,4,0,0" Text="Reading Windows' event logs…" />
                </StackPanel>
                <Button x:Name="ReloadButton" Style="{StaticResource Btn}" Content="Read again" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Reload_Click" IsEnabled="False" />
            </Grid>
            <ProgressBar x:Name="Busy" Height="4" Margin="0,0,0,12" IsIndeterminate="True" />

            <!-- Counts -->
            <UniformGrid x:Name="Tiles" Columns="4" Margin="-6,0" />

            <!-- Per day -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Problems per day" Style="{StaticResource T.Card}" />
                        <TextBlock x:Name="DayText" Style="{StaticResource T.Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <c:DayBars x:Name="Days" Height="120" />
                </StackPanel>
            </Border>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!-- Events -->
                <StackPanel>
                    <TextBlock Text="What happened" Style="{StaticResource T.Card}" Margin="2,0,2,8" />
                    <Border Style="{StaticResource Card}" Padding="18,6">
                        <StackPanel>
                            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" Focusable="False" PreviewMouseWheel="Inner_PreviewMouseWheel">
                                <ItemsControl x:Name="EventList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" Foreground="{Binding ToneBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Label}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource T.Label}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="EventNote" Style="{StaticResource T.Sub}" Margin="0,12" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Apps with the most problems" Style="{StaticResource T.Card}" Margin="2,0,2,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="TopApps" />
                    </Border>

                    <TextBlock Text="Start-up time" Style="{StaticResource T.Card}" Margin="2,24,2,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel x:Name="BootList" />
                            <TextBlock x:Name="BootNote" Style="{StaticResource T.Sub}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="Footer" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Faint}" Margin="2,14,0,0" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="CoreWatch.Pages.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
    </UserControl.Resources>
    <Grid Margin="32,4,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel Margin="0,0,560,0">
                <TextBlock Text="Apps" Style="{StaticResource T.Page}" />
                <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" Margin="0,4,0,0" Text="Loading installed apps…" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Border Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabDesktop" Style="{StaticResource Seg}" GroupName="appsTab" Content="Desktop apps" IsChecked="True" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabStore" Style="{StaticResource Seg}" GroupName="appsTab" Content="Preinstalled" Checked="Tab_Checked" />
                    </StackPanel>
                </Border>
                <Grid x:Name="SearchBox" Width="280">
                    <TextBox x:Name="Search" Padding="32,7,10,7" TextChanged="Search_TextChanged" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="13" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="Search apps or publishers" Foreground="{StaticResource B.Faint}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Desktop apps -->
        <Border x:Name="DesktopView" Grid.Row="1" Style="{StaticResource Card}" Padding="8,4,4,8">
            <DataGrid x:Name="Table" Sorting="Table_Sorting" RowHeight="44">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="22" Height="22" Margin="0,0,12,0">
                                        <TextBlock Text="&#xECAA;" Style="{StaticResource T.Icon}" FontSize="17" Foreground="{StaticResource B.Faint}" HorizontalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Publisher" Width="220" Binding="{Binding Publisher}" ElementStyle="{StaticResource Cell.Dim}" />
                    <DataGridTextColumn Header="Version" Width="130" Binding="{Binding Version}" ElementStyle="{StaticResource Cell.Dim}" />
                    <DataGridTextColumn Header="Installed" Width="116" Binding="{Binding InstalledText}" SortMemberPath="Installed" ElementStyle="{StaticResource Cell.Dim}" />
                    <DataGridTextColumn x:Name="SizeColumn" Header="Size" Width="100" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Head.Right}" />
                    <DataGridTemplateColumn Width="112" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BtnGhost}" Content="Uninstall" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Right"
                                        IsEnabled="{Binding CanUninstall}" Tag="{Binding}" Click="Uninstall_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Apps that came with Windows or the PC -->
        <ScrollViewer x:Name="StoreView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="22,18">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,260,0">
                                <TextBlock x:Name="StoreTitle" Style="{StaticResource T.Card}" Text="Looking for preinstalled apps…" />
                                <TextBlock x:Name="StoreDetail" Style="{StaticResource T.Label}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None"
                                           Text="Apps that came with Windows or the PC. Removing one only affects your account, and each can be installed again from the Microsoft Store." />
                            </StackPanel>
                            <Button x:Name="RemoveButton" Style="{StaticResource Btn}" Content="Remove selected" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="False" Click="RemoveSelected_Click" />
                        </Grid>
                        <ProgressBar x:Name="StoreBusy" Height="4" Margin="0,16,0,0" IsIndeterminate="True" />
                    </StackPanel>
                </Border>

                <Border x:Name="StoreCard" Style="{StaticResource Card}" Padding="18,4" Margin="0,12,0,0" Visibility="Collapsed">
                    <ItemsControl x:Name="StoreList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" ToolTip="{Binding PackageName}">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Border Style="{StaticResource Chip}" Margin="0,1,6,1" Visibility="{Binding HasNote, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource T.Label}" FontSize="11.5" Foreground="{StaticResource B.Warn}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Label}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <StackPanel x:Name="RemovedPanel" Visibility="Collapsed">
                    <TextBlock Text="Removed here" Style="{StaticResource T.Card}" Margin="2,22,2,8" />
                    <Border Style="{StaticResource Card}" Padding="18,4">
                        <ItemsControl x:Name="RemovedList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,9">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding When}" Style="{StaticResource T.Label}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Style="{StaticResource Btn}" Content="Get it back" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="{Binding}" Click="Restore_Click"
                                                ToolTip="Opens its page in the Microsoft Store" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <TextBlock Style="{StaticResource T.Label}" Foreground="{StaticResource B.Faint}" Margin="2,14,0,8" TextWrapping="Wrap" TextTrimming="None"
                           Text="Only apps from a fixed list are offered here. The Store, Photos, Calculator, Notepad, Terminal, Snipping Tool and Windows' own components are never listed. A large Windows update can bring some of these apps back." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

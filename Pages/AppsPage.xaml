<UserControl x:Class="CoreWatch.Pages.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,4,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Apps" Style="{StaticResource T.Page}" />
                <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" Margin="0,4,0,0" Text="Loading installed apps…" />
            </StackPanel>
            <Grid Width="280" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBox x:Name="Search" Padding="32,7,10,7" TextChanged="Search_TextChanged" />
                <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="13" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search apps or publishers" Foreground="{StaticResource B.Faint}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,4,4,8">
            <DataGrid x:Name="Table" Sorting="Table_Sorting" RowHeight="44">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="22" Height="22" Margin="0,0,12,0">
                                        <TextBlock Text="&#xECAA;" Style="{StaticResource T.Icon}" FontSize="17" Foreground="{StaticResource B.Faint}" HorizontalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Publisher" Width="220" Binding="{Binding Publisher}" ElementStyle="{StaticResource Cell.Dim}" />
                    <DataGridTextColumn Header="Version" Width="130" Binding="{Binding Version}" ElementStyle="{StaticResource Cell.Dim}" />
                    <DataGridTextColumn Header="Installed" Width="116" Binding="{Binding InstalledText}" SortMemberPath="Installed" ElementStyle="{StaticResource Cell.Dim}" />
                    <DataGridTextColumn x:Name="SizeColumn" Header="Size" Width="100" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Head.Right}" />
                    <DataGridTemplateColumn Width="112" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BtnGhost}" Content="Uninstall" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Right"
                                        IsEnabled="{Binding CanUninstall}" Tag="{Binding}" Click="Uninstall_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

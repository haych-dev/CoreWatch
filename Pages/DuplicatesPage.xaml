<UserControl x:Class="CoreWatch.Pages.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="1560">
            <TextBlock Text="Duplicates" Style="{StaticResource T.Page}" />
            <TextBlock Style="{StaticResource T.Sub}" Margin="0,4,0,20"
                       Text="Find files with exactly the same contents, and large files you have not changed in a long time. Anything you remove goes to the Recycle Bin." />

            <!-- Scan -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" KeyDown="PathBox_KeyDown" />
                        <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Browse" Margin="10,0,0,0" Click="Browse_Click" />
                        <Button x:Name="ScanButton" Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="Scan" MinWidth="92" Margin="10,0,0,0" Click="Scan_Click" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource T.Label}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,400,0" TextTrimming="None"
                                   Text="Windows, Program Files and AppData are skipped unless you scan inside them, and cloud-only files are never downloaded." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Ignore files under" Style="{StaticResource T.Label}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Border Background="{StaticResource B.CardAlt}" CornerRadius="8" Padding="3">
                                <StackPanel x:Name="SizePanel" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Seg}" GroupName="dupSize" Content="100 KB" Tag="102400" />
                                    <RadioButton Style="{StaticResource Seg}" GroupName="dupSize" Content="1 MB" Tag="1048576" IsChecked="True" />
                                    <RadioButton Style="{StaticResource Seg}" GroupName="dupSize" Content="10 MB" Tag="10485760" />
                                    <RadioButton Style="{StaticResource Seg}" GroupName="dupSize" Content="100 MB" Tag="104857600" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Height="4" />
                        <TextBlock x:Name="ProgressText" Margin="0,10,0,0" />
                        <TextBlock x:Name="ProgressPath" Style="{StaticResource T.Label}" Margin="0,3,0,0" FontFamily="{StaticResource F.Mono}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel x:Name="Results" Visibility="Collapsed">
                <Grid Margin="0,22,0,10">
                    <Border HorizontalAlignment="Left" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabDup" Style="{StaticResource Seg}" GroupName="dupTab" Content="Duplicate files" IsChecked="True" Checked="Tab_Checked" />
                            <RadioButton x:Name="TabOld" Style="{StaticResource Seg}" GroupName="dupTab" Content="Large old files" Checked="Tab_Checked" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="DupActions" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn}" Content="Select all but the oldest copy" Click="SelectExtra_Click" />
                        <Button Style="{StaticResource Btn}" Content="Clear selection" Margin="10,0,0,0" Click="ClearSelection_Click" />
                        <Button x:Name="DeleteButton" Style="{StaticResource Btn}" Content="Move to Recycle Bin" Margin="10,0,0,0" IsEnabled="False" Click="Delete_Click" />
                    </StackPanel>
                    <StackPanel x:Name="OldActions" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                        <TextBlock Text="Not changed for" Style="{StaticResource T.Label}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Seg}" GroupName="oldAge" Content="6 months" Tag="6" Checked="Age_Checked" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="oldAge" Content="1 year" Tag="12" IsChecked="True" Checked="Age_Checked" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="oldAge" Content="2 years" Tag="24" Checked="Age_Checked" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="Summary" Style="{StaticResource T.Sub}" Margin="2,0,0,10" />

                <!-- Duplicate groups -->
                <ItemsControl x:Name="GroupList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18,12,10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,8,6">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding WastedText}" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" ToolTip="{Binding Path}" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource T.Label}" FontSize="11.5" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding ChangedText}" Style="{StaticResource T.Label}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    <Button Grid.Column="3" Style="{StaticResource BtnIcon}" Content="&#xE838;" ToolTip="Show in File Explorer" Tag="{Binding Path}" Click="Open_Click" Margin="6,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Old files -->
                <Border x:Name="OldCard" Style="{StaticResource Card}" Padding="18,6,10,6" Visibility="Collapsed">
                    <ItemsControl x:Name="OldList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel ToolTip="{Binding Path}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource T.Label}" FontSize="11.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ChangedText}" Style="{StaticResource T.Label}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Style="{StaticResource BtnIcon}" Content="&#xE838;" ToolTip="Show in File Explorer" Tag="{Binding Path}" Click="Open_Click" />
                                        <Button Style="{StaticResource BtnIcon}" Content="&#xE74D;" ToolTip="Move to Recycle Bin" Tag="{Binding}" Click="OldDelete_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock x:Name="MoreNote" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Faint}" Margin="2,6,0,0" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

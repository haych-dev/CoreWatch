<UserControl x:Class="CoreWatch.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="1560">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Startup" Style="{StaticResource T.Page}" />
                    <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" Margin="0,4,0,0" Text="Apps that launch when you sign in" />
                </StackPanel>
                <Button Style="{StaticResource Btn}" Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click" />
            </Grid>

            <Border Style="{StaticResource Card}" Padding="18,6">
                <StackPanel>
                    <ItemsControl x:Name="EntryList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="28" Height="28" Margin="0,0,16,0">
                                        <TextBlock Text="&#xECAA;" Style="{StaticResource T.Icon}" FontSize="20" Foreground="{StaticResource B.Faint}" HorizontalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding Command}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource T.Label}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Faint}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource T.Label}" FontSize="11.5" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding StateText}" Style="{StaticResource T.Label}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Click="Toggle_Click" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="Empty" Style="{StaticResource T.Sub}" Margin="0,14" Text="No startup apps were found." Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource T.Label}" Foreground="{StaticResource B.Faint}" Margin="2,14,0,0" TextWrapping="Wrap"
                       Text="Turning an app off here uses the same switch as Task Manager: the app stays installed and can be turned back on at any time. Entries that apply to all users need administrator rights." />
        </StackPanel>
    </ScrollViewer>
</UserControl>

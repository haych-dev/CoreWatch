<UserControl x:Class="CoreWatch.Pages.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CoreWatch.Controls">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="TileGrid">
            <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="AppTile">
            <Border Margin="0,0,10,10" Padding="12,10" CornerRadius="8" Background="{StaticResource B.CardAlt}" ToolTip="{Binding Id}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Label}" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11.5" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Installed}" Value="True"><Setter Property="Foreground" Value="{StaticResource B.Good}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Failed}" Value="True"><Setter Property="Foreground" Value="{StaticResource B.Bad}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Foreground" Value="{StaticResource B.Accent}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="1560">
            <TextBlock Text="Install" Style="{StaticResource T.Page}" />
            <TextBlock Style="{StaticResource T.Sub}" Margin="0,4,0,20"
                       Text="Tick the apps you want and install them in one go. Downloads come from each publisher through winget, Windows' own package manager, with no bundled extras." />

            <!-- Summary -->
            <Border Style="{StaticResource Card}" Padding="22,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SummaryTitle" Style="{StaticResource T.Card}" Text="Nothing selected" />
                            <TextBlock x:Name="SummaryDetail" Style="{StaticResource T.Label}" Margin="0,2,0,0" Text="Checking which apps are already installed…" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="220" Margin="0,0,10,0">
                                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" />
                                <TextBlock x:Name="SearchHint" Text="Filter apps" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Faint}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <Button x:Name="UpdateButton" Style="{StaticResource Btn}" Content="Update all apps" Click="UpdateAll_Click" />
                            <Button x:Name="InstallButton" Style="{StaticResource Btn}" Content="Install selected" MinWidth="124" Margin="10,0,0,0" IsEnabled="False" Click="Install_Click" />
                            <Button x:Name="StopButton" Style="{StaticResource Btn}" Content="Stop after this app" Margin="10,0,0,0" Visibility="Collapsed" Click="Stop_Click" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="Busy" Height="4" Margin="0,16,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Live output -->
            <StackPanel x:Name="LogPanel" Visibility="Collapsed">
                <TextBlock Text="Output" Style="{StaticResource T.Card}" Margin="2,22,2,8" />
                <c:OutputLog x:Name="Log" />
            </StackPanel>

            <StackPanel x:Name="Groups" />

            <TextBlock Style="{StaticResource T.Label}" Foreground="{StaticResource B.Faint}" Margin="2,14,0,0" TextWrapping="Wrap" TextTrimming="None"
                       Text="Installing an app accepts its publisher's licence terms on your behalf. Some installers ask for administrator permission while they run. To remove an app later, use the Apps page." />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="CoreWatch.Pages.ToolboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CoreWatch.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <DataTemplate x:Key="RepairTemplate">
            <Grid Margin="0,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="18" Margin="2,0,18,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                    <WrapPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border Style="{StaticResource Chip}" Margin="0,1,6,1" Visibility="{Binding HasNote, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Note}" Style="{StaticResource T.Label}" FontSize="11.5" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,1,6,1" Visibility="{Binding Locked, Converter={StaticResource Vis}}">
                            <TextBlock Text="Needs administrator" Style="{StaticResource T.Label}" FontSize="11.5" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Label}" TextWrapping="Wrap" TextTrimming="None" LineHeight="18"
                               Margin="0,5,0,0" MaxWidth="860" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Btn}" Content="{Binding Action}" MinWidth="104" IsEnabled="{Binding Enabled}" Tag="{Binding}" Click="Repair_Click" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PanelTemplate">
            <Button Style="{StaticResource Btn}" Margin="0,0,10,10" Padding="14,11" HorizontalContentAlignment="Left" Tag="{Binding}" Click="Panel_Click" ToolTip="{Binding Tip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="16" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="1560">
            <TextBlock Text="Toolbox" Style="{StaticResource T.Page}" />
            <TextBlock Style="{StaticResource T.Sub}" Margin="0,4,0,20"
                       Text="Windows' own repair tools without the command line, and shortcuts to the settings panels that are hard to find." />

            <Border x:Name="AdminBar" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,4" Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,12,0" />
                        <TextBlock Style="{StaticResource T.Label}" FontSize="12.5" VerticalAlignment="Center" Text="Most repairs change Windows itself and need administrator rights." />
                    </StackPanel>
                    <Button Style="{StaticResource Btn}" Content="Restart as administrator" HorizontalAlignment="Right" Click="Admin_Click" />
                </Grid>
            </Border>

            <TextBlock Text="Repair" Style="{StaticResource T.Card}" Margin="2,18,2,8" />
            <Border Style="{StaticResource Card}" Padding="18,4">
                <ItemsControl x:Name="RepairList" Focusable="False" ItemTemplate="{StaticResource RepairTemplate}" />
            </Border>

            <StackPanel x:Name="LogPanel" Visibility="Collapsed">
                <Grid Margin="2,22,2,8">
                    <TextBlock x:Name="LogTitle" Text="Output" Style="{StaticResource T.Card}" VerticalAlignment="Center" />
                    <Button x:Name="CancelButton" Style="{StaticResource Btn}" Content="Cancel" HorizontalAlignment="Right" Click="Cancel_Click" Visibility="Collapsed" />
                </Grid>
                <ProgressBar x:Name="Busy" Height="4" Margin="0,0,0,8" Visibility="Collapsed" />
                <c:OutputLog x:Name="Log" />
            </StackPanel>

            <TextBlock Text="Windows panels" Style="{StaticResource T.Card}" Margin="2,24,2,8" />
            <Border Style="{StaticResource Card}" Padding="16,16,6,6">
                <ItemsControl x:Name="PanelList" Focusable="False" ItemTemplate="{StaticResource PanelTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

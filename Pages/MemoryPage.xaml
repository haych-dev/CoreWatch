<UserControl x:Class="CoreWatch.Pages.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CoreWatch.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="1560">
            <TextBlock Text="Memory" Style="{StaticResource T.Page}" />
            <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" Margin="0,4,0,20" />

            <!-- Composition -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UsedText" Style="{StaticResource T.Big}" Foreground="{StaticResource B.Mem}" Text="—" />
                            <TextBlock x:Name="UsedDetail" Style="{StaticResource T.Label}" FontSize="13" Margin="12,0,0,7" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock x:Name="AvailText" Style="{StaticResource T.Label}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                    </Grid>
                    <c:SegmentBar x:Name="Composition" Height="14" Margin="0,14,0,12" />
                    <ItemsControl x:Name="Legend" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,30,0" ToolTip="{Binding Tip}">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Label}" Margin="8,0,8,0" />
                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:LineChart x:Name="MemChart" Height="150" Margin="0,20,0,0" />
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="Stats">
                        <TextBlock Text="Details" Style="{StaticResource T.Card}" Margin="0,0,0,6" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Free up memory" Style="{StaticResource T.Card}" />
                        <TextBlock Style="{StaticResource T.Sub}" Margin="0,8,0,0" LineHeight="19"
                                   Text="Trimming asks every app to hand back memory it is not actively using. Windows pages it back in on demand, so nothing is lost. It helps most right before launching something heavy." />
                        <Button x:Name="TrimButton" Style="{StaticResource BtnPrimary}" Content="Trim working sets" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Trim_Click" />
                        <Border Height="1" Background="{StaticResource B.Line}" Margin="0,18" />
                        <TextBlock Style="{StaticResource T.Sub}" LineHeight="19"
                                   Text="The standby cache holds recently used files in otherwise idle RAM. Windows releases it automatically; clearing it by hand only helps in rare cases where a game stutters with a full cache." />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="StandbyButton" Style="{StaticResource Btn}" Content="Clear standby cache" Click="Standby_Click" />
                            <Border x:Name="AdminChip" Style="{StaticResource Chip}" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Needs administrator" Style="{StaticResource T.Label}" FontSize="11.5" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ResultText" Foreground="{StaticResource B.Good}" Margin="0,16,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top consumers -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="What is using memory" Style="{StaticResource T.Card}" />
                        <TextBlock Text="Grouped by app  ·  private working set" Style="{StaticResource T.Label}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl x:Name="Consumers" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" MaxWidth="170" />
                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Value="{Binding Pct, Mode=OneWay}" Foreground="{StaticResource B.Mem}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

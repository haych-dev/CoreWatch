<UserControl x:Class="CoreWatch.Pages.PowerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CoreWatch.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <c:InverseVisibility x:Key="Hide" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="1560">
            <TextBlock Text="Power" Style="{StaticResource T.Page}" />
            <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" Margin="0,4,0,20" Text="Checking the battery and power plans…" />

            <!-- Battery -->
            <Border Style="{StaticResource Card}" Padding="22,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="BatteryDial" Width="112" Height="112" Margin="0,0,26,0" Visibility="Collapsed">
                        <c:RingGauge x:Name="Gauge" Thickness="9" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="GaugeText" FontFamily="{StaticResource F.Display}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="charged" Style="{StaticResource T.Label}" FontSize="11" Foreground="{StaticResource B.Faint}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="NoBatteryIcon" Text="&#xE945;" Style="{StaticResource T.Icon}" FontSize="30" Foreground="{StaticResource B.Accent}" Margin="4,0,22,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="BatteryTitle" Style="{StaticResource T.Card}" Text="—" />
                        <TextBlock x:Name="BatteryDetail" Style="{StaticResource T.Sub}" Margin="0,4,0,0" />
                        <StackPanel x:Name="BatteryFacts" Margin="0,10,0,0" MaxWidth="460" HorizontalAlignment="Left" MinWidth="380" />
                    </StackPanel>
                    <Button x:Name="ReportButton" Grid.Column="2" Style="{StaticResource Btn}" Content="Open Windows' battery report" VerticalAlignment="Top" Click="Report_Click" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Plans -->
            <TextBlock Text="Power plan" Style="{StaticResource T.Card}" Margin="2,24,2,8" />
            <Border Style="{StaticResource Card}" Padding="18,4">
                <StackPanel>
                    <ItemsControl x:Name="PlanList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Chip}" Background="{StaticResource B.AccentSoft}" Margin="12,0,0,0" Visibility="{Binding Active, Converter={StaticResource Vis}}">
                                                <TextBlock Text="In use" FontSize="11.5" Foreground="{StaticResource B.Accent}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Label}" TextWrapping="Wrap" TextTrimming="None" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Use this plan" MinWidth="116" Tag="{Binding}" Click="Plan_Click" VerticalAlignment="Center"
                                            Visibility="{Binding Active, Converter={StaticResource Hide}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="PlanNote" Style="{StaticResource T.Sub}" Margin="0,14" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock Text="More in Windows" Style="{StaticResource T.Card}" Margin="2,24,2,8" />
            <Border Style="{StaticResource Card}" Padding="16,16,6,6">
                <WrapPanel>
                    <Button Style="{StaticResource Btn}" Margin="0,0,10,10" Padding="14,11" Content="Power and sleep settings" Tag="ms-settings:powersleep" Click="Open_Click" />
                    <Button Style="{StaticResource Btn}" Margin="0,0,10,10" Padding="14,11" Content="Classic Power Options" Tag="powercfg.cpl" Click="Open_Click" />
                    <Button x:Name="BatteryUsageButton" Style="{StaticResource Btn}" Margin="0,0,10,10" Padding="14,11" Content="Battery usage by app" Tag="ms-settings:batterysaver-usagedetails" Click="Open_Click" Visibility="Collapsed" />
                </WrapPanel>
            </Border>

            <TextBlock Style="{StaticResource T.Label}" Foreground="{StaticResource B.Faint}" Margin="2,14,0,0" TextWrapping="Wrap" TextTrimming="None"
                       Text="Switching plan takes effect straight away and can be switched back here. Many newer laptops only offer Balanced and adjust it through the power mode slider in Windows Settings." />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="CoreWatch.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="1560">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="History" Style="{StaticResource T.Page}" />
                    <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" Margin="0,4,0,0" Text="Loading readings…" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="3">
                    <StackPanel x:Name="RangePanel" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Seg}" GroupName="historyRange" Content="1 hour" Tag="1" Checked="Range_Checked" />
                        <RadioButton Style="{StaticResource Seg}" GroupName="historyRange" Content="24 hours" Tag="24" IsChecked="True" Checked="Range_Checked" />
                        <RadioButton Style="{StaticResource Seg}" GroupName="historyRange" Content="7 days" Tag="168" Checked="Range_Checked" />
                        <RadioButton Style="{StaticResource Seg}" GroupName="historyRange" Content="30 days" Tag="720" Checked="Range_Checked" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="Charts" />

            <Border x:Name="EmptyCard" Style="{StaticResource Card}" Padding="22,20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Nothing recorded for this period yet" Style="{StaticResource T.Card}" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource T.Sub}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource T.Label}" Foreground="{StaticResource B.Faint}" Margin="2,14,0,0" TextWrapping="Wrap" TextTrimming="None"
                       Text="Readings are saved once a minute while CoreWatch is running, including when it is hidden next to the clock. Gaps in a chart are times it was not running. Everything stays on this PC." />
        </StackPanel>
    </ScrollViewer>
</UserControl>

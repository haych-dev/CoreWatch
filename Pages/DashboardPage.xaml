<UserControl x:Class="CoreWatch.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CoreWatch.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="1560">

            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource T.Page}" />
                    <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="FreeMemoryButton" Style="{StaticResource Btn}" Content="Free up memory" Click="FreeMemory_Click" />
                    <Button Style="{StaticResource Btn}" Content="Scan for junk" Margin="10,0,0,0" Click="ScanJunk_Click" />
                    <Button x:Name="RefreshButton" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="Refresh_Click"
                            ToolTip="Releases memory, flushes the DNS cache and removes temporary files older than a day. Nothing you would miss is touched.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource F.Icon}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="Refresh PC" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- One-click refresh: progress and results -->
            <Border x:Name="RefreshCard" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,44,0">
                            <TextBlock x:Name="RefreshIcon" Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="20" Foreground="{StaticResource B.Accent}" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="RefreshTitle" Style="{StaticResource T.Card}" />
                                <TextBlock x:Name="RefreshDetail" Style="{StaticResource T.Label}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="RefreshClose" Style="{StaticResource BtnIcon}" Content="&#xE8BB;" FontSize="11" ToolTip="Dismiss" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshClose_Click" />
                    </Grid>
                    <ProgressBar x:Name="RefreshBusy" Height="4" Margin="0,14,0,0" />
                    <ItemsControl x:Name="RefreshSteps" Focusable="False" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Mark}" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{Binding Tone}" HorizontalAlignment="Left" Margin="3,0,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Result}" Style="{StaticResource T.Label}" FontSize="13" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Gauges -->
            <UniformGrid Rows="1" Margin="-6,0">
                <c:GaugeCard x:Name="CpuGauge" Title="Processor" Color="{StaticResource C.Cpu}" Margin="6,0" />
                <c:GaugeCard x:Name="MemGauge" Title="Memory" Color="{StaticResource C.Mem}" Margin="6,0" />
                <c:GaugeCard x:Name="GpuGauge" Title="Graphics" Color="{StaticResource C.Gpu}" Margin="6,0" />
                <c:GaugeCard x:Name="VramGauge" Title="GPU memory" Color="{StaticResource C.Vram}" Margin="6,0" />
                <c:GaugeCard x:Name="DiskGauge" Title="System drive" Color="{StaticResource C.Disk}" Margin="6,0" />
            </UniformGrid>

            <!-- Activity + insights -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.75*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="Activity" Style="{StaticResource T.Card}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource B.Cpu}" VerticalAlignment="Center" />
                                <TextBlock x:Name="LegendCpu" Style="{StaticResource T.Label}" Margin="7,0,18,0" Text="CPU" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource B.Mem}" VerticalAlignment="Center" />
                                <TextBlock x:Name="LegendMem" Style="{StaticResource T.Label}" Margin="7,0,18,0" Text="Memory" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource B.Gpu}" VerticalAlignment="Center" />
                                <TextBlock x:Name="LegendGpu" Style="{StaticResource T.Label}" Margin="7,0,0,0" Text="GPU" />
                            </StackPanel>
                        </Grid>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="ChartSpan" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Faint}" FontSize="11" Margin="0,8,0,0" />
                        <c:LineChart x:Name="ActivityChart" Height="216" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,18,10,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Insights" Style="{StaticResource T.Card}" Margin="0,0,0,8" />
                        <ItemsControl x:Name="InsightList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BtnGhost}" Padding="8,9" HorizontalContentAlignment="Stretch" Tag="{Binding Route}" Click="Insight_Click" Margin="-8,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" Foreground="{Binding Tone}" FontSize="17" VerticalAlignment="Top" Margin="0,2,12,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Label}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{StaticResource B.Faint}" Margin="8,0,2,0"
                                                       Visibility="{Binding ChevronVisibility}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Storage / throughput / system -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Drives" Style="{StaticResource T.Card}" Margin="0,0,0,6" />
                        <ItemsControl x:Name="DriveList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,9,0,3">
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Label}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{Binding Pct, Mode=OneWay}" Foreground="{Binding Bar}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Throughput" Style="{StaticResource T.Card}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="14" /><RowDefinition /></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Download" Style="{StaticResource T.Label}" />
                                <TextBlock x:Name="NetDown" Style="{StaticResource T.Value}" FontSize="17" Margin="0,2,0,6" Text="—" />
                                <c:LineChart x:Name="NetDownChart" Height="34" ShowGrid="False" Maximum="0" MinAutoMaximum="10240" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Upload" Style="{StaticResource T.Label}" />
                                <TextBlock x:Name="NetUp" Style="{StaticResource T.Value}" FontSize="17" Margin="0,2,0,6" Text="—" />
                                <c:LineChart x:Name="NetUpChart" Height="34" ShowGrid="False" Maximum="0" MinAutoMaximum="10240" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Disk read" Style="{StaticResource T.Label}" />
                                <TextBlock x:Name="DiskRead" Style="{StaticResource T.Value}" FontSize="17" Margin="0,2,0,6" Text="—" />
                                <c:LineChart x:Name="DiskReadChart" Height="34" ShowGrid="False" Maximum="0" MinAutoMaximum="102400" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Disk write" Style="{StaticResource T.Label}" />
                                <TextBlock x:Name="DiskWrite" Style="{StaticResource T.Value}" FontSize="17" Margin="0,2,0,6" Text="—" />
                                <c:LineChart x:Name="DiskWriteChart" Height="34" ShowGrid="False" Maximum="0" MinAutoMaximum="102400" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel x:Name="SystemPanel">
                        <TextBlock Text="This PC" Style="{StaticResource T.Card}" Margin="0,0,0,6" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

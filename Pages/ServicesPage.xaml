<UserControl x:Class="CoreWatch.Pages.ServicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
    </UserControl.Resources>
    <Grid Margin="32,4,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel Margin="0,0,620,0">
                <TextBlock Text="Services" Style="{StaticResource T.Page}" />
                <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" Margin="0,4,0,0" Text="Loading services…" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Border Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Seg}" GroupName="serviceFilter" Content="All" Tag="all" IsChecked="True" Checked="Filter_Checked" />
                        <RadioButton Style="{StaticResource Seg}" GroupName="serviceFilter" Content="Running" Tag="running" Checked="Filter_Checked" />
                        <RadioButton Style="{StaticResource Seg}" GroupName="serviceFilter" Content="Not from Windows" Tag="third" Checked="Filter_Checked" />
                        <RadioButton Style="{StaticResource Seg}" GroupName="serviceFilter" Content="Changed here" Tag="changed" Checked="Filter_Checked" />
                    </StackPanel>
                </Border>
                <Grid Width="240">
                    <TextBox x:Name="Search" Padding="32,7,10,7" TextChanged="Search_TextChanged" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="13" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="Filter services" Foreground="{StaticResource B.Faint}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </StackPanel>
        </Grid>

        <Border x:Name="AdminBar" Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource T.Icon}" FontSize="15" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource T.Label}" FontSize="12.5" VerticalAlignment="Center" Text="You can look, but starting, stopping or changing a service needs administrator rights." />
                </StackPanel>
                <Button Style="{StaticResource Btn}" Content="Restart as administrator" HorizontalAlignment="Right" Click="Admin_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,4,4,8">
            <DataGrid x:Name="Table" SelectionChanged="Table_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="DisplayName" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="7,2" Visibility="{Binding Changed, Converter={StaticResource Vis}}">
                                        <TextBlock Text="Changed here" FontSize="11" Foreground="{StaticResource B.Good}" />
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="7,2" Visibility="{Binding Protected, Converter={StaticResource Vis}}">
                                        <TextBlock Text="Protected" FontSize="11" Foreground="{StaticResource B.Dim}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="150" SortMemberPath="State" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StateText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Startup" Width="170" Binding="{Binding StartText}" SortMemberPath="StartOrder" />
                    <DataGridTextColumn Header="Service name" Width="230" Binding="{Binding Name}" ElementStyle="{StaticResource Cell.Dim}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Details and actions for the selected service -->
        <Border x:Name="Detail" Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,16" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock x:Name="DetailName" Style="{StaticResource T.Card}" />
                        <TextBlock x:Name="DetailText" Style="{StaticResource T.Label}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54" LineHeight="18" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="StartButton" Style="{StaticResource Btn}" Content="Start" MinWidth="80" Click="Start_Click" />
                        <Button x:Name="StopButton" Style="{StaticResource Btn}" Content="Stop" MinWidth="80" Margin="8,0,0,0" Click="Stop_Click" />
                        <Button x:Name="UndoButton" Style="{StaticResource Btn}" Content="Undo change" Margin="8,0,0,0" Click="Undo_Click" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Startup type" Style="{StaticResource T.Label}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Border Background="{StaticResource B.CardAlt}" CornerRadius="8" Padding="3">
                            <StackPanel x:Name="StartPanel" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Seg}" GroupName="serviceStart" Content="Automatic" Tag="2" Click="StartType_Click" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="serviceStart" Content="Automatic (delayed)" Tag="2d" Click="StartType_Click" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="serviceStart" Content="Manual" Tag="3" Click="StartType_Click" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="serviceStart" Content="Disabled" Tag="4" Click="StartType_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DetailNote" Style="{StaticResource T.Label}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="CoreWatch.Pages.ProcessesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,4,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Processes" Style="{StaticResource T.Page}" />
                <TextBlock x:Name="SubTitle" Style="{StaticResource T.Sub}" Margin="0,4,0,0" Text="—" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Grid Width="280">
                    <TextBox x:Name="Search" Padding="32,7,10,7" TextChanged="Search_TextChanged" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="13" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="Filter by name or PID" Foreground="{StaticResource B.Faint}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <Button x:Name="EndButton" Style="{StaticResource BtnDanger}" Content="End task" Margin="10,0,0,0" IsEnabled="False" Click="EndTask_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,4,4,8">
            <DataGrid x:Name="Table" Sorting="Table_Sorting" SelectionChanged="Table_SelectionChanged" PreviewMouseRightButtonDown="Table_RightDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="End task" Click="EndTask_Click" />
                        <MenuItem Header="End process tree" Click="EndTree_Click" />
                        <Separator />
                        <MenuItem Header="Open file location" Click="OpenLocation_Click" />
                        <MenuItem Header="Copy name" Click="CopyName_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="18" Height="18" Margin="0,0,11,0">
                                        <TextBlock Text="&#xECAA;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{StaticResource B.Faint}" HorizontalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PID" Width="84" Binding="{Binding Pid}" ElementStyle="{StaticResource Cell.Dim}" />
                    <DataGridTextColumn Header="CPU" Width="84" Binding="{Binding CpuText}" SortMemberPath="Cpu" ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Head.Right}" />
                    <DataGridTextColumn x:Name="MemColumn" Header="Memory" Width="112" Binding="{Binding MemText}" SortMemberPath="Mem" ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Head.Right}" />
                    <DataGridTextColumn Header="GPU memory" Width="124" Binding="{Binding GpuText}" SortMemberPath="Gpu" ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Head.Right}" />
                    <DataGridTextColumn Header="Threads" Width="92" Binding="{Binding Threads}" ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Head.Right}" />
                    <DataGridTextColumn Header="Handles" Width="96" Binding="{Binding Handles}" ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Head.Right}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

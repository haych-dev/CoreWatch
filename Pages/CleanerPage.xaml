<UserControl x:Class="CoreWatch.Pages.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="RuleTemplate">
            <Grid Margin="0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Available}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="17" Margin="16,0,14,0" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Label}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Restart CoreWatch as administrator (Settings) to clean this">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Locked}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Needs administrator" Style="{StaticResource T.Label}" FontSize="11.5" />
                </Border>
                <TextBlock Grid.Column="4" Text="{Binding SizeText}" MinWidth="170" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,4,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="1560">
            <TextBlock Text="Cleaner" Style="{StaticResource T.Page}" />
            <TextBlock Style="{StaticResource T.Sub}" Margin="0,4,0,20"
                       Text="Removes caches, temp files and leftovers that Windows and apps rebuild on their own. Nothing is deleted until you press Clean." />

            <!-- Summary -->
            <Border Style="{StaticResource Card}" Padding="22,20">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TotalText" Style="{StaticResource T.Big}" Foreground="{StaticResource B.Accent}" Margin="0,0,16,0" Visibility="Collapsed" />
                            <StackPanel Margin="0,0,0,5" VerticalAlignment="Bottom">
                                <TextBlock x:Name="TotalLabel" Style="{StaticResource T.Card}" Text="Not analyzed yet" />
                                <TextBlock x:Name="TotalDetail" Style="{StaticResource T.Label}" Text="Analyze to see how much space can be recovered." />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="AnalyzeButton" Style="{StaticResource BtnPrimary}" Content="Analyze" MinWidth="104" Click="Analyze_Click" />
                            <Button x:Name="CleanButton" Style="{StaticResource Btn}" Content="Clean" MinWidth="104" Margin="10,0,0,0" IsEnabled="False" Click="Clean_Click" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="Busy" IsIndeterminate="False" Height="4" Margin="0,18,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="Groups" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
